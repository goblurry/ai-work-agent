          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/inquiries/{inquiry_id}/review": {
      "post": {
        "tags": [
          "담당자"
        ],
        "summary": "담당자 · 초안 저장·최종 답변 확정",
        "description": "edit는 내부 초안만 저장합니다. complete는 최종 답변으로 확정하며 웹 문의의 학생 조회에 표시합니다. 전화 문의는 통화 안내를 완료한 것으로 기록합니다.",
        "operationId": "review_inquiry_inquiries__inquiry_id__review_post",
        "parameters": [
          {
            "name": "inquiry_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Inquiry Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewInquiry"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComposeReply": {
        "properties": {
          "choice": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "check"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Choice",
            "description": "예 / 아니요 / 추가 확인 필요"
          },
          "memo": {
            "type": "string",
            "maxLength": 4000,
            "title": "Memo",
            "description": "판단 이유 또는 추가 안내",
            "default": ""
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "선택형 질문이 없는 문의의 담당자 판단"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ComposeReply"
      },
      "ContinueInquiry": {
        "properties": {
          "inquiry_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "graduation",
                  "course_recognition",
                  "leave_return",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Inquiry Type",
            "description": "문의 유형 변경"
          },
          "details": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InquiryDetails"
              },
              {
                "type": "null"
              }
            ],
            "description": "변경할 상세 항목만 입력"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile",
            "description": "추가 확인한 학생 조건, 입력한 항목만 변경"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of",
            "description": "판단 기준일"
          },
          "target_term": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Term",
            "description": "문의 대상 학기"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ContinueInquiry"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InquiryDetails": {
        "properties": {
          "required_course_code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{5}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Course Code",
            "description": "지정 과목 학수번호 (모름: null)"
          },
          "completed_course_code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{5}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed Course Code",
            "description": "이수한 과목 학수번호 (모름: null)"
          },
          "procedure": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "leave",
                  "return"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Procedure",
            "description": "휴학 / 복학"
          },
          "application_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "not_applied",
                  "saved",
                  "submitted",
                  "received",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Application Status",
            "description": "미신청 / 임시저장 / 제출 / 접수완료 / 모름"
          },
          "application_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Application Date",
            "description": "신청일 (실제 접수일과 구분)"
          },
          "receipt_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receipt Date",
            "description": "실제 접수일 (확인한 경우만)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "InquiryDetails"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Username",
            "examples": [
              "student"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "NewInquiry": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Question",
            "description": "행정 담당자가 처리할 문의 내용",
            "examples": [
              "복학 신청 절차를 알려 주세요."
            ]
          },
          "inquiry_type": {
            "type": "string",
            "enum": [
              "graduation",
              "course_recognition",
              "leave_return",
              "other"
            ],
            "title": "Inquiry Type",
            "description": "graduation: 졸업·교과과정 / course_recognition: 과목 인정 / leave_return: 휴학·복학 / other: 기타",
            "default": "other"
          },
          "details": {
            "$ref": "#/components/schemas/InquiryDetails",
            "description": "유형별 상세 조건. 모르는 값은 null"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile",
            "description": "학생 입력 또는 담당자가 확인한 조건"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of",
            "description": "판단 기준일 (YYYY-MM-DD), 비우면 오늘"
          },
          "target_term": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Term",
            "description": "문의 대상 학기",
            "examples": [
              "2026-2"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "NewInquiry"
      },
      "Profile": {
        "properties": {
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department",
            "description": "학생의 소속 학과 (문의 대상 전공 학과와 구분)",
            "examples": [
              "컴퓨터공학과"
            ]
          },
          "target_department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Department",
