              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/inquiries/{inquiry_id}/run": {
      "post": {
        "tags": [
          "담당자"
        ],
        "summary": "담당자 · Agent 실행·재실행",
        "description": "본문 없이 실행하거나, 변경한 profile·details 등을 본문으로 보내 저장 후 바로 재실행합니다. 검색·조건 확인 후 담당자용 결과를 반환합니다. 학수번호 문의는 support_summary에 확인된 과목 정보·미확인 항목·출처를, draft에 읽기 쉬운 근거 요약을 제공합니다. 최종 답변은 담당자가 /review로 확정합니다. trace에 실제 실행 기록이 남습니다.",
        "operationId": "run_inquiry_inquiries__inquiry_id__run_post",
        "parameters": [
          {
            "name": "inquiry_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Inquiry Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ContinueInquiry"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/inquiries/{inquiry_id}": {
      "get": {
        "tags": [
          "담당자"
        ],
        "summary": "담당자 · 문의 상세·실행 기록 조회",
        "operationId": "read_inquiry_inquiries__inquiry_id__get",
        "parameters": [
          {
            "name": "inquiry_id",
