{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "에이전트 응답 결과 (3분기)",
  "description": "우리 기여 C3. 분기 코드는 평가셋(04 문서)의 기대동작 라벨과 1:1 대응한다. 이관 사유 유형은 Alibaba 에스컬레이션 연구(arXiv:2605.14830)의 유형 분류 아이디어를 차용.",
  "type": "object",
  "required": ["branch", "trace"],
  "properties": {
    "branch": {
      "enum": ["A_draft", "B_need_info", "C_undetermined"],
      "description": "A=답변 초안 / B=학생에게 물을 것 있음 / C=공개자료로 확정 불가"
    },

    "draft": {
      "type": ["string", "null"],
      "description": "A일 때만. 직원이 검토·수정할 초안. 학생에게 직접 발송되지 않는다."
    },

    "evidence": {
      "type": "array",
      "description": "모든 사실 주장에 대응. 비어 있으면 branch는 A가 될 수 없다.",
      "items": {
        "type": "object",
        "required": ["chunk_id", "url", "why_applicable"],
        "properties": {
          "chunk_id":       { "type": "string" },
          "url":            { "type": "string" },
          "article":        { "type": ["string", "null"] },
          "quote":          { "type": "string" },
          "why_applicable": { "type": "string", "description": "이 학생·이 시점에 왜 적용되는지" }
        }
      }
    },

    "ask_student": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "B일 때. 직원이 학생에게 물어볼 항목 목록"
    },

    "undetermined": {
      "type": ["object", "null"],
      "description": "C일 때",
      "properties": {
        "reason": { "enum": ["근거없음", "자료충돌", "최신성불명", "재량영역"] },
        "conflicts": {
          "type": "array",
          "description": "자료가 충돌하면 자동 선택하지 않고 양쪽을 모두 싣는다",
          "items": { "type": "object", "properties": { "chunk_id": {"type":"string"}, "claim": {"type":"string"} } }
        },
        "next_actions": { "type": "array", "items": { "type": "string" }, "description": "학과 확인 / 상위부서 확인 등" }
      }
    },

    "trace": {
      "type": "array",
      "description": "화면에 그대로 노출. 출처 중심 UI 문헌(arXiv:2606.13854) 및 정리본 §6",
      "items": {
        "type": "object",
        "properties": {
          "step":   { "enum": ["의도분류", "학생조건확인", "자료검색", "학기공지확인", "적용조건검증", "재검색"] },
          "detail": { "type": "string" },
          "hits":   { "type": "integer" }
        }
      }
    }
  }
}
